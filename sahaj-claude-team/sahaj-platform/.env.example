# Copy to .env and fill in. Never commit .env. Agents cannot read it.
# PostgreSQL superuser (only used once, by scripts/setup/create-database.mjs)
PG_HOST=localhost
PG_PORT=5432
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=change-me

# Roles created by the setup script
SAHAJ_DB_MIGRATOR_PASSWORD=change-me-migrator
SAHAJ_DB_APP_PASSWORD=change-me-app

# Used by the Spring Boot app (dev) and by integration tests (test)
SAHAJ_DB_URL=jdbc:postgresql://localhost:5432/sahaj_dev
SAHAJ_TEST_DB_URL=jdbc:postgresql://localhost:5432/sahaj_test
