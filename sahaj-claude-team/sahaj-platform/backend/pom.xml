<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.sahaj</groupId>
  <artifactId>sahaj-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>sahaj-backend</name>
  <description>Sahaj clinic and hospital platform - backend modular monolith</description>
  <packaging>jar</packaging>

  <properties>
    <java.version>17</java.version>
    <spring-modulith.version>1.4.14</spring-modulith.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <!-- JDBC (not JPA) for SAH-1/SAH-2: the sales_enquiry table is insert-only for sahaj_app, so a
         JPA save (select-then-merge) or INSERT ... RETURNING would be refused by the grants. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- Flyway 10 moved PostgreSQL support into its own module. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <!-- Spring Modulith: enforces the api-package boundary rule between modules (ADR-001 D2).
         spring-modulith-apt (module documentation generation, not needed for verification) is
         excluded: it pulls spring-boot-configuration-processor, which registers itself as a
         javac annotation processor and broke compilation on the Spring Boot 3.3.4 artifacts cached
         on this machine; it is still not needed for verification. -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-core</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.modulith</groupId>
          <artifactId>spring-modulith-apt</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- SAH-3: access tokens. TokenService (application port) hides this behind an interface so a
         later Keycloak-backed implementation can replace it without touching callers. -->
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>0.12.6</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>0.12.6</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>0.12.6</version>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Integration tests (*IT.java, written by qa-engineer) run in the verify phase against
           the sahaj_test database with profile "test". Unit and slice tests run in surefire. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <spring.profiles.active>test</spring.profiles.active>
            <!-- ADR-008 R9 / T13: the packaged jar the QA test opens. In the dev-tools profile the build directory
                 and final name differ, so this resolves to that profile's jar. The test fails if it is missing. -->
            <sahaj.packagedJar>${project.build.directory}/${project.build.finalName}.jar</sahaj.packagedJar>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- DEC-016 / ADR-008: the dev-only sample admin endpoint lives in a separate source set that is compiled
       ONLY with -Pdev-tools. Without the profile the compiler never sees src/devtools. The profile also uses its
       own build directory, so stale dev classes can never be packed into a production jar built from target/.
       Never copy a jar built with this profile to a shared machine (its name and manifest identify it). -->
  <profiles>
    <profile>
      <id>dev-tools</id>
      <properties>
        <!-- ADR-008 R7: nothing built with this profile reaches ~/.m2 or a remote repository under the production
             coordinates. -->
        <maven.install.skip>true</maven.install.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
      </properties>
      <build>
        <directory>${project.basedir}/target-devtools</directory>
        <finalName>sahaj-backend-devtools-${project.version}</finalName>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.1</version>
            <executions>
              <execution>
                <id>add-devtools-source</id>
                <phase>generate-sources</phase>
                <goals>
                  <goal>add-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>${project.basedir}/src/devtools/java</source>
                  </sources>
                </configuration>
              </execution>
              <execution>
                <id>add-devtools-resource</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>add-resource</goal>
                </goals>
                <configuration>
                  <resources>
                    <resource>
                      <directory>${project.basedir}/src/devtools/resources</directory>
                    </resource>
                  </resources>
                </configuration>
              </execution>
              <!-- Unit tests of the dev-tools classes cannot sit in src/test (it compiles without the profile). -->
              <execution>
                <id>add-devtools-test-source</id>
                <phase>generate-test-sources</phase>
                <goals>
                  <goal>add-test-source</goal>
                </goals>
                <configuration>
                  <sources>
                    <source>${project.basedir}/src/devtools/test/java</source>
                  </sources>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <!-- ADR-008 R7: spring-boot:build-image never uses the production image name; the localhost/ prefix keeps a
               stray docker push away from a public registry. -->
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <configuration>
              <image>
                <name>localhost/sahaj-backend-devtools:${project.version}</name>
                <publish>false</publish>
              </image>
            </configuration>
          </plugin>
          <!-- Identifies a dev-tools jar. spring-boot:repackage keeps the manifest entries of the plain jar. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <configuration>
              <archive>
                <manifestEntries>
                  <Sahaj-Dev-Tools>true</Sahaj-Dev-Tools>
                </manifestEntries>
              </archive>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <sahaj.devtools>true</sahaj.devtools>
              </systemPropertyVariables>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <sahaj.devtools>true</sahaj.devtools>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
