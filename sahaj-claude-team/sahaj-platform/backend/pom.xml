<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.sahaj</groupId>
  <artifactId>sahaj-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>sahaj-backend</name>
  <description>Sahaj clinic and hospital platform - backend modular monolith</description>
  <packaging>jar</packaging>

  <properties>
    <java.version>17</java.version>
    <spring-modulith.version>1.3.0</spring-modulith.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Core Spring Boot - no web, no data, no database driver (ADR-001 D3) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>

    <!-- Spring Modulith: enforces the api-package boundary rule between modules (ADR-001 D2).
         spring-modulith-apt (module documentation generation, not needed for verification) is
         excluded: it pulls spring-boot-configuration-processor, which registers itself as a
         javac annotation processor and is incompatible with the cached Spring Boot 3.3.4
         artifacts on this machine, breaking compilation with no benefit to this story. -->
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-core</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.modulith</groupId>
          <artifactId>spring-modulith-apt</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.modulith</groupId>
      <artifactId>spring-modulith-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

</project>
